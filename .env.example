# Supabase (public anon credentials — insert-only RLS, safe to ship in the client).
# Expo inlines EXPO_PUBLIC_* vars into the bundle. Copy to .env and fill in from
# your Supabase project settings (Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key
