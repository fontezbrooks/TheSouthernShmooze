# Supabase (public anon credentials — insert-only RLS, safe to ship in the client).
# Expo inlines EXPO_PUBLIC_* vars into the bundle. Copy to .env and fill in from
# your Supabase project settings (Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key

# PostHog (project "The Southern Shmooze", org The Southern Shmooze). Public
# project token — safe to ship in the client. For EAS/TestFlight builds these
# must ALSO be set as EAS environment variables (local .env never reaches
# build workers). Capture is off in dev unless EXPO_PUBLIC_POSTHOG_DEBUG=1.
EXPO_PUBLIC_POSTHOG_KEY=phc_your-project-token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
